# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Deixe VAZIO em produção/Docker: as chamadas ficam relativas ao host e o
# nginx faz o proxy (ver nginx.template.conf / docker-compose.yml).
# Em desenvolvimento local, aponte para o backend diretamente, ex.:
#   VUE_APP_API_URL=http://127.0.0.1:8000/vehicle-rental/api
#   VUE_APP_API_URL_MEDIA=http://127.0.0.1:8000
VUE_APP_API_URL=/vehicle-rental/api
VUE_APP_API_URL_MEDIA=

# ---------------------------------------------------------------------------
# Google reCAPTCHA v2 Site Key
# Obtenha sua chave em: https://www.google.com/recaptcha/admin
# ---------------------------------------------------------------------------
VUE_APP_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
